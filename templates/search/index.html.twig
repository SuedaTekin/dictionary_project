{% extends 'base.html.twig' %}

{% block title %}Sözlükte Ara{% endblock %}

{% block body %}
{# --- SAĞ ÜST BUTON GRUBU --- #}
<div style="position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; gap: 10px;">
    {# Ayarlar Butonu (Çark Simgesi) #}
    <a href="{{ path('admin_dictionary_index') }}" class="btn shadow" style="border-radius: 50px; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; background-color: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color);">
        <i class="bi bi-gear-fill"></i>
    </a>

    {# Gece/Gündüz Modu Butonu #}
    <button id="dark-mode-toggle" class="btn btn-outline-success shadow" style="border-radius: 50px; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; background-color: var(--card-bg);">
        <i class="bi bi-moon-fill" id="mode-icon"></i>
    </button>
</div>

<style>
    :root { 
        --bg-color: #f8f9fa; 
        --card-bg: #ffffff; 
        --text-color: #212529; 
        --border-color: #dee2e6;
        --accent-green: #198754;
    }

    [data-bs-theme="dark"] { 
        --bg-color: #0b0e14 !important; 
        --card-bg: #161b22 !important; 
        --text-color: #f0f6fc !important; 
        --border-color: #30363d !important;
        --accent-green: #10b981 !important;
    }

    /* Arka plan zorlaması */
    html, body {
        background-color: var(--bg-color) !important;
        color: var(--text-color) !important;
        transition: all 0.3s ease;
        min-height: 100vh;
    }

    .card { 
        background-color: var(--card-bg) !important; 
        color: var(--text-color) !important; 
        border: 1px solid var(--border-color) !important;
        border-radius: 12px;
    }

    .form-control {
        background-color: var(--card-bg) !important;
        color: var(--text-color) !important;
        border: 1px solid var(--border-color) !important;
    }
</style>

<div class="container mt-5">
    {# Arama Formu #}
    <div class="card p-4 mb-4 shadow-lg" style="background-color: #2c3e50 !important; color: white !important;">
        <h2 class="mb-3"><i class="bi bi-book-half"></i> Sözlükte Ara</h2>
        <form action="{{ path('app_dictionary_search') }}" method="GET" class="input-group mb-3">
            <input type="text" name="q" class="form-control form-control-lg" placeholder="Bir kelime arayın..." value="{{ app.request.query.get('q') }}">
            <button class="btn btn-success px-4" type="submit">ARA</button>
        </form>
        
        <div class="d-flex flex-wrap gap-2">
            {% for letter in ['ç', 'ğ', 'ı', 'ö', 'ş', 'ü', 'â', 'î', 'û'] %}
                <button class="btn btn-sm btn-success">{{ letter }}</button>
            {% endfor %}
        </div>
    </div>

    {# Günün Kelimesi #}
    <div class="card p-4 shadow border-start border-success border-4">
        <span class="badge bg-success mb-2" style="width: fit-content;">GÜNÜN KELİMESİ</span>
        <h3 class="display-6 text-success fw-bold">MEB`USLUK</h3>
        <p class="fs-5 mt-2">Meb`usun sıfatı ve durumu.</p>
    </div>
</div>

<script>
    const modeToggle = document.getElementById('dark-mode-toggle');
    const modeIcon = document.getElementById('mode-icon');
    const htmlElement = document.documentElement;

    function updateIcon(theme) {
        if (theme === 'dark') {
            modeIcon.classList.replace('bi-moon-fill', 'bi-sun-fill');
        } else {
            modeIcon.classList.replace('bi-sun-fill', 'bi-moon-fill');
        }
    }

    // İlk yükleme ayarı
    if (localStorage.getItem('theme') === 'dark') {
        updateIcon('dark');
    }

    modeToggle.addEventListener('click', () => {
        if (htmlElement.getAttribute('data-bs-theme') === 'dark') {
            htmlElement.removeAttribute('data-bs-theme');
            localStorage.setItem('theme', 'light');
            updateIcon('light');
        } else {
            htmlElement.setAttribute('data-bs-theme', 'dark');
            localStorage.setItem('theme', 'dark');
            updateIcon('dark');
        }
    });
</script>
{% endblock %}