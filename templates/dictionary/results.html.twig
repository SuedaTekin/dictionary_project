<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Sözlük Projesi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Yeşil Sayfalama Stilleri */
        .pagination .page-item.active .page-link {
            background-color: #198754 !important;
            border-color: #198754 !important;
            color: white !important;
        }
        .pagination .page-link { color: #198754 !important; }
        .pagination .page-link:hover { background-color: #d1e7dd !important; }

        /* Harf Butonları Stilleri */
        .char-btn {
            background-color: #198754;
            border: none;
            color: white;
            font-weight: bold;
            width: 38px;
            height: 38px;
            margin-top: 5px;
            transition: 0.2s;
        }
        .char-btn:hover { background-color: #157347; transform: scale(1.1); }
    </style>
</head>
<body class="bg-light">

<div class="container mt-5">
    <div class="p-4 rounded shadow-sm text-white" style="background-color: #2c3e50;">
        <h2 class="mb-4">Sözlükte Ara</h2>
        
        <form action="{{ path('app_dictionary_search') }}" method="GET">
            <div class="input-group mb-2">
                <input type="text" id="searchInput" name="q" class="form-control form-control-lg" placeholder="Kelime yazın..." value="{{ query }}">
                <button class="btn btn-success px-4" type="submit">ARA</button>
            </div>

            <!-- Özel Harf Butonları -->
            <div class="special-chars">
                {% set chars = ['ç', 'ğ', 'ı', 'ö', 'ş', 'ü', 'â', 'î', 'û'] %}
                {% for char in chars %}
                    <button type="button" class="btn char-btn">{{ char }}</button>
                {% endfor %}
            </div>
        </form>
    </div>

    <div class="mt-4">
        {% if results is not empty %}
            {% for item in results %}
                <div class="card mb-3 shadow-sm border-0">
                    <div class="card-body">
                        <h3 class="text-danger">{{ item.name }}</h3>
                        <p class="lead">{{ item.description }}</p>
                    </div>
                </div>
            {% endfor %}

            {# Yeşil Sayfalama Butonları #}
            {% if totalPages > 1 %}
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('app_dictionary_search', {q: query, page: currentPage - 1}) }}">Geri</a>
                        </li>

                        {% for i in 1..totalPages %}
                            <li class="page-item {{ i == currentPage ? 'active' : '' }}">
                                <a class="page-link" href="{{ path('app_dictionary_search', {q: query, page: i}) }}">{{ i }}</a>
                            </li>
                        {% endfor %}

                        <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                            <a class="page-link" href="{{ path('app_dictionary_search', {q: query, page: currentPage + 1}) }}">İleri</a>
                        </li>
                    </ul>
                </nav>
            {% endif %}

        {% elseif query %}
            <div class="alert alert-info">"{{ query }}" için sonuç bulunamadı.</div>
        {% endif %}
    </div>
</div>

<script>
    // Harf butonlarına basınca inputa ekleme yapan kod
    document.querySelectorAll('.char-btn').forEach(button => {
        button.addEventListener('click', function() {
            const char = this.innerText;
            const input = document.getElementById('searchInput');
            input.value += char;
            input.focus();
        });
    });
</script>

</body>
</html>