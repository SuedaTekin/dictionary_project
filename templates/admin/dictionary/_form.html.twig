{# templates/admin/dictionary/_form.html.twig #}
{{ form_start(form) }}
    <div class="mb-3">
        {{ form_label(form.name, 'Kelime Adı', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Örn: Abaküs'}}) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.description, 'Anlamı / Açıklama', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '5'}}) }}
    </div>
    <button class="btn btn-success w-100">{{ button_label|default('Kaydet') }}</button>
{{ form_end(form) }}